    "paywall_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Freiberufler und Einzelunternehmer in den USA und der EU: Belege scannen, Ausgaben kategorisieren und für Steuern exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For freelancers and sole traders in the US and EU: scan receipts, categorize spending, and export for taxes—without corporate bloat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para autónomos en EE. UU. y la UE: escanea recibos, categoriza y exporta para impuestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les indépendants aux US et dans l’UE : scannez vos reçus, classez les dépenses et exportez pour les impôts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per freelance e professionisti in USA e UE: scansiona ricevute, categorizza e esporta per le tasse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor zzp’ers in de VS en EU: bonnen scannen, categoriseren en exporteren voor belasting."
