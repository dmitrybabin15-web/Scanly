    "onboarding_2_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzen Sie die Dokumentenkamera oder wählen Sie ein Foto aus Ihrer Mediathek. Die Texterkennung erfolgt auf Ihrem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the document camera or pick a photo from your library. Text is recognized on your device; you choose what to save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la cámara de documentos o elige una foto. El texto se reconoce en el dispositivo; tú decides qué guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la caméra document ou choisissez une photo. Le texte est reconnu sur l’appareil ; vous choisissez quoi enregistrer."
