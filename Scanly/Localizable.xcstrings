    "onboarding_3_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie bis zu 5 Belege im kostenlosen Plan. Scanly Pro bietet unbegrenzte Scans und vollen Export. Upgrade jederzeit in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save up to 5 receipts on the free plan. Scanly Pro unlocks unlimited scans and full export. Upgrade anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda hasta 5 recibos gratis. Scanly Pro desbloquea escaneos ilimitados y exportación completa. Mejora en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez jusqu’à 5 reçus gratuitement. Scanly Pro débloque des scans illimités et l’export complet. Passez à Pro dans Réglages."
