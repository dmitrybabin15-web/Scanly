        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva fino a 5 ricevute gratis. Scanly Pro sblocca scansioni illimitate e export completo. Passa a Pro in Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar tot 5 bonnen gratis. Scanly Pro geeft onbeperkt scannen en export. Upgrade in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz do 5 paragonów w planie darmowym. Scanly Pro daje nielimitowane skany i pełny eksport. Ulepsz w Ustawieniach."
          }
        }
      }
    },
