    "paywall_payment_terms": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung erfolgt über Ihre Apple‑ID. Das Abonnement verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ende der Laufzeit gekündigt wird. Verwaltung unter Einstellungen → Apple‑ID → Abonnements."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment will be charged to your Apple ID. Subscription renews automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings → Apple ID → Subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cobrará a tu Apple ID. La suscripción se renueva salvo que canceles al menos 24 h antes del fin del periodo. Gestiona en Ajustes → Apple ID → Suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement sera facturé à votre identifiant Apple. L’abonnement se renouvelle automatiquement sauf résiliation au moins 24 h avant la fin de la période. Gérez dans Réglages → Identifiant Apple → Abonnements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’addebito avviene sul tuo ID Apple. L’abbonamento si rinnova automaticamente salvo disdetta almeno 24 h prima del termine. Gestisci in Impostazioni → ID Apple → Abbonamenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Betaling via je Apple ID. Het abonnement verlengt automatisch tenzij je minstens 24 uur van tevoren opzegt. Beheer via Instellingen → Apple ID → Abonnementen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płatność z Apple ID. Subskrypcja odnawia się automatycznie, chyba że anulujesz co najmniej 24 h przed końcem okresu. Zarządzaj w Ustawienia → Apple ID → Subskrypcje."
          }
        }
      }
    },
