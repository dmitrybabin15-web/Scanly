    "scan_empty_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision liest den Text. Wenn Sie ANTHROPIC_API_KEY im Run-Schema setzen, füllt Claude Händler, Betrag und Kategorie automatisch aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision reads the text. If you set ANTHROPIC_API_KEY in the Run scheme, Claude fills merchant, amount, and category automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision lee el texto. Si configuras ANTHROPIC_API_KEY en el esquema de ejecución, Claude completa comercio, importe y categoría automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision lit le texte. Si vous définissez ANTHROPIC_API_KEY dans le schéma d’exécution, Claude remplit automatiquement le marchand, le montant et la catégorie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision legge il testo. Se imposti ANTHROPIC_API_KEY nello schema di esecuzione, Claude compila automaticamente esercente, importo e categoria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision leest de tekst. Als je ANTHROPIC_API_KEY in het run-schema zet, vult Claude handelaar, bedrag en categorie automatisch in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision odczytuje tekst. Jeśli ustawisz ANTHROPIC_API_KEY w schemacie uruchomienia, Claude automatycznie uzupełni sprzedawcę, kwotę i kategorię."
          }
        }
      }
    },
